{
  "name": "ecoshield-caspian",
  "version": "0.0.0",
  "private": true,
  "description": "Eco-Shield of the Caspian: early-warning platform for Caspian protected areas (hackathon MVP)",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "lefthook install",
    "test:hygiene": "node --test \"scripts/**/*.test.mjs\"",
    "hygiene:unpushed": "node scripts/commit-hygiene.mjs unpushed",
    "check": "bash scripts/check.sh",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "node packages/db/src/migrate.ts",
    "db:seed": "node packages/db/src/seed.ts",
    "demo:start": "bash scripts/demo.sh start",
    "demo:reset": "bash scripts/demo.sh reset",
    "smoke": "playwright test -c e2e",
    "up": "bash scripts/up.sh"
  },
  "devDependencies": {
    "lefthook": "2.2.2",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
